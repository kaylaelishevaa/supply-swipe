modules = ["nodejs-20", "python-3.12", "web"]
run = "npm install && npm run build && npm start"

[deployment]
build = ["sh", "-c", "npm install && npm run build"]
run = ["sh", "-c", "npm start"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 3000
externalPort = 80

[nix]
channel = "stable-25_05"
