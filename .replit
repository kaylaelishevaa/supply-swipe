# Replit config: build once, then serve the production build on $PORT (default 3000).
modules = ["nodejs-20"]
run = "npm install && npm run build && npm start"

[deployment]
build = ["sh", "-c", "npm install && npm run build"]
run = ["sh", "-c", "npm start"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 3000
externalPort = 80
